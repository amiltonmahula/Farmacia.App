<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Farmacia.App.Page.AdminPage.FuncionarioPage">
    
     <VerticalStackLayout Padding="20" Spacing="15">
        
        <Label Text="Funcionários e Administradores"
               FontSize="30"
               FontAttributes="Bold"></Label>
        
        <SearchBar Placeholder="Pesquisar funcionários..." 
                   Text="{Binding Pesquisa}"></SearchBar>
        
        <ActivityIndicator IsRunning="{Binding EstaCarregando}"
                           IsVisible="{Binding EstaCarregando }"></ActivityIndicator>
        
        <CollectionView ItemsSource="{Binding Usuarios}"
                            SelectionMode="None"
                            HeightRequest="280">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum funcionário encontrado."
                           Padding="10"></Label>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Margin="0,4"
                                Stroke="#DDDDDD"
                                StrokeShape="RoundRectangle 19"
                                >
                            <Grid ColumnDefinitions="*, Auto"
                                  RowDefinitions="Auto, Auto, Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="5">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Nome}"
                                       FontAttributes="Bold"
                                       FontSize="16"></Label>
                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Email}"></Label>
                                <Label Grid.Row="2"
                                       Grid.Column="0"
                                       Text="{Binding Cargo}"></Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        
        <Label Text="{Binding Mensagem}"
               TextColor="Red"></Label>
    </VerticalStackLayout>
</ContentPage>