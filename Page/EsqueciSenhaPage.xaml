<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Farmacia.App.Page.EsqueciSenhaPage">
   
    <Grid RowDefinitions="Auto, Auto, *">
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20"
            Spacing="15">
            <Entry
                Placeholder="Email"
                PlaceholderColor="Black"
                FontSize="16"
                Keyboard="Email"
                x:Name="Email"></Entry>
            <Entry
                Placeholder="Código de confirmação"
                PlaceholderColor="Black"
                FontSize="16"
                Keyboard="Codigo"
                x:Name="Codigo"></Entry>
            <Entry
                Placeholder="Reconfirmar"
                PlaceholderColor="Black"
                FontSize="16"
                Keyboard="Reconfirmar"
                x:Name="Reconfirmar"></Entry>
        </VerticalStackLayout>
        <Button
            Grid.Row="1"
            Text="Confirmar"
            FontSize="Medium"></Button>
    </Grid>
    
</ContentPage>